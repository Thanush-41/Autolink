# API
API_PORT=8000
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=autolink
REDIS_URL=redis://localhost:6379/0
APP_ENV=development

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000

